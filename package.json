{
  "name": "local-queue-tv-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One Windows PC, one browser login, three independent queue displays on the LAN.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test tests/browser.integration.js",
    "install:browser": "playwright install chromium",
    "test:video": "node --test tests/video.integration.js",
    "test:direct": "node --test tests/direct.integration.js tests/gateway.integration.js",
    "test:pwa": "node --test tests/pwa.integration.js"
  },
  "dependencies": {
    "playwright": "1.65.1",
    "tough-cookie": "^6.1.0"
  }
}
